          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals
        }) + suffix;
        element.dataset.currentVal = end;
        return;
      }

      if (element._animId) {
        cancelAnimationFrame(element._animId);
      }

      const startTime = performance.now();
      const change = end - start;

      // easeOutExpo
      function easeOutExpo(t) {
        return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
      }

      function step(now) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const ease = easeOutExpo(progress);
        const current = start + (change * ease);

        element.textContent = prefix + current.toLocaleString('en-US', {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals
        }) + suffix;

        if (progress < 1) {
          element._animId = requestAnimationFrame(step);
        } else {
          element.textContent = prefix + end.toLocaleString('en-US', {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals
          }) + suffix;
          element.dataset.currentVal = end;
          element._animId = null;
        }
      }

      element._animId = requestAnimationFrame(step);
    }

