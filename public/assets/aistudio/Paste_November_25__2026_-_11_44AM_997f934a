        btn.className = 'table-curr-btn px-3 py-1.5 text-xs font-semibold rounded bg-blue-600 text-white transition-all shadow-[0_0_8px_rgba(59,130,246,0.35)]';
        renderBankTable(true);
      });
    });

    document.querySelectorAll('.rate-type-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        tableRateType = btn.dataset.rateType;
        document.querySelectorAll('.rate-type-btn').forEach(b => {
          b.className = 'rate-type-btn px-3 py-1.5 text-xs font-medium rounded text-slate-400 hover:text-white transition-colors';
        });
        btn.className = 'rate-type-btn px-3 py-1.5 text-xs font-semibold rounded bg-[#182236] text-white border border-[#2a3b58] transition-colors';
        renderBankTable(true);
      });
    });

    const searchInput = document.getElementById('bank-search-input');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim();
        renderBankTable(false);
      });
    }

    // Theme toggle button click listener for visual feedback
    const themeBtn = document.getElementById('theme-toggle-btn');
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const icon = themeBtn.querySelector('.material-symbols-outlined');
        if (icon) {
          icon.classList.add('rotate-180');
          setTimeout(() => icon.classList.remove('rotate-180'), 400);
        }
      });
    }

    // Initial render with count-up ticker animation
    updateConverter(true);
    renderChart(true);
  })();
